# 本文件只提供变量名称和本地开发示例，不得填写或提交生产密钥。
APP_PORT=8790
NPM_REGISTRY=https://registry.npmjs.org
DATABASE_URL=postgres://workbench:replace-with-local-password@127.0.0.1:5432/workbench
POSTGRES_PASSWORD=replace-with-local-password
AUTH_SECRET=replace-with-a-long-random-secret
INVENTORY_ENCRYPTION_KEY=replace-with-a-32-byte-random-key
# 外部集成（P2，密钥仅服务端使用）
# SHUKU_API_URL=
# SHUKU_API_KEY=
# SHUKU_HEALTH_PATH=/api/health
# SHUKU_AUTH_STYLE=bearer
# NIMAIL_API_URL=
# NIMAIL_API_KEY=
# NIMAIL_HEALTH_PATH=/api/health
# NIMAIL_AUTH_STYLE=bearer
# 备份目录（Docker 生产环境默认 /backups）
# BACKUP_DIR=/backups
# 可选：使用预构建镜像而非本地 build（见 .github/workflows/docker.yml）
# WORKBENCH_IMAGE=ghcr.io/onlylm/workbench:latest
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=replace-with-a-strong-local-password
